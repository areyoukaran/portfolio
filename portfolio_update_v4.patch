+  async function handleContactSubmit(e) {
+    e.preventDefault();
+    const form = e.target;
+    const btn = form.querySelector('.submit-btn');
+    const label = btn.querySelector('.btn-label');
+    const statusEl = document.getElementById('formStatus');
+    const original = label.textContent;
+
+    // Honeypot: if this hidden field got filled, silently drop (bot)
+    if (form.botcheck.checked) return false;
+
+    btn.disabled = true;
+    label.textContent = 'Sending…';
+    statusEl.textContent = '';
+    statusEl.className = 'form-status';
+
+    try {
+      const res = await fetch('https://api.web3forms.com/submit', {
+        method: 'POST',
+        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
+        body: JSON.stringify({
+          access_key: form.access_key.value,
+          name: form.name.value,
+          email: form.email.value,
+          message: form.message.value,
+          subject: `Portfolio contact from ${form.name.value}`,
+          from_name: 'karankashyap.me contact form'
+        })
+      });
+      const data = await res.json();
+
+      if (data.success) {
+        label.textContent = 'Sent ✓';
+        btn.classList.add('is-sent');
+        statusEl.textContent = "Thanks - I'll get back to you soon.";
+        statusEl.className = 'form-status is-success';
+        form.reset();
+      } else {
+        throw new Error(data.message || 'Something went wrong');
+      }
+    } catch (err) {
+      label.textContent = 'Try again';
+      statusEl.textContent = `Couldn't send that - email me directly at kashyapkaran483@gmail.com instead.`;
+      statusEl.className = 'form-status is-error';
+    } finally {
+      btn.disabled = false;
+      setTimeout(() => {
+        label.textContent = original;
+        btn.classList.remove('is-sent');
+      }, 3000);
+    }
+
+    return false;
+  }
+</script>
