--- a/css/style.css
+++ b/css/style.css
@@ -567,6 +567,149 @@ h2 {
 .project-row:hover strong,
 .project-row:hover b { color: var(--accent); }
 
+/* ---------- Project cards (GitHub projects grid) ---------- */
+.projects-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 18px;
+  margin-top: 28px;
+}
+
+.project-card {
+  position: relative;
+  display: flex;
+  flex-direction: column;
+  gap: 14px;
+  min-height: 100%;
+  padding: 26px 24px 24px;
+  background: var(--bg-raised);
+  border: 1px solid var(--line);
+  border-radius: 10px;
+  overflow: hidden;
+  transition: transform .2s ease, border-color .2s ease, background .2s ease;
+}
+
+.project-card::before {
+  content: '';
+  position: absolute;
+  inset: 0 0 auto 0;
+  height: 2px;
+  background: linear-gradient(90deg, var(--accent), transparent 70%);
+  opacity: 0;
+  transition: opacity .2s ease;
+}
+
+.project-card:hover {
+  transform: translateY(-3px);
+  border-color: var(--accent-dim);
+  background: #1f2229;
+}
+
+.project-card:hover::before { opacity: 1; }
+
+.project-card-top {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 12px;
+}
+
+.project-card-top h3 {
+  font: 500 1.08rem 'Space Grotesk', sans-serif;
+  color: var(--text);
+  margin: 0;
+}
+
+.project-card-index {
+  font: .68rem 'IBM Plex Mono', monospace;
+  color: var(--accent-dim);
+  flex: none;
+  padding-top: 3px;
+}
+
+.project-card p {
+  margin: 0;
+  color: var(--text-dim);
+  font-size: .87rem;
+  line-height: 1.6;
+}
+
+.project-card-tags {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+  margin-top: 2px;
+}
+
+.project-tag {
+  font: .66rem 'IBM Plex Mono', monospace;
+  color: var(--text-dim);
+  border: 1px solid var(--line);
+  padding: 3px 9px;
+  border-radius: 3px;
+  transition: border-color .15s ease, color .15s ease;
+}
+
+.project-card:hover .project-tag { border-color: var(--accent-dim); }
+
+.project-card-links {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 10px;
+  margin-top: auto;
+  padding-top: 10px;
+}
+
+.project-link {
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  font: .74rem 'IBM Plex Mono', monospace;
+  color: var(--text);
+  border: 1px solid var(--line);
+  padding: 8px 13px;
+  border-radius: 5px;
+  transition: border-color .15s ease, color .15s ease, background .15s ease;
+}
+
+.project-link svg { width: 14px; height: 14px; flex: none; }
+
+.project-link:hover {
+  border-color: var(--accent);
+  color: var(--accent);
+}
+
+.project-link.is-primary {
+  background: var(--accent);
+  color: #14161a;
+  border-color: var(--accent);
+  font-weight: 500;
+}
+
+.project-link.is-primary:hover { background: #ffc670; color: #14161a; }
+
+.project-link.is-primary svg { fill: #14161a; }
+.project-link:not(.is-primary) svg { fill: var(--text-dim); }
+.project-link:not(.is-primary):hover svg { fill: var(--accent); }
+
+.project-card-featured {
+  grid-column: 1 / -1;
+  border-color: var(--accent-dim);
+  background: linear-gradient(160deg, #1f2229, var(--bg-raised) 60%);
+}
+
+.project-card-featured::before { opacity: 1; }
+
+.project-card-featured .project-card-top h3 { font-size: 1.2rem; }
+
+.project-card-featured p { max-width: 760px; font-size: .9rem; }
+
+.projects-more {
+  margin-top: 22px;
+  display: flex;
+  justify-content: flex-start;
+}
+
